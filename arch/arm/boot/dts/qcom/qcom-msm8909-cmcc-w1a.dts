// SPDX-License-Identifier: GPL-2.0-only
/*
 * CMCC W1A kids locator watch
 *
 * SoC: Qualcomm MSM8909 (APQ8009-class), PMIC PM8916
 * Display: 400x400 round AMOLED (RM67162-class), DSI via MDP3
 * Touch: FocalTech FT3267 @ blsp_i2c5 0x38 (mainline driver missing, node
 *        kept for the bring-up driver port)
 * Storage: eMMC (userdata = "sdcard" p33, firmware p1)
 *
 * Reference: downstream 3.18 DTB (stock-dtbs/01.dtb), acer-t01 mainline port.
 */

/dts-v1/;

#include "qcom-msm8909-pm8909.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "CMCC W1A";
	compatible = "cmcc,w1a", "qcom,msm8909";
	chassis-type = "watch";

	aliases {
		serial0 = &blsp_uart1;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		stdout-path = "serial0";

		/*
		 * No hand-written framebuffer node: lk2nd injects the real
		 * one (actual MDP3 format/stride/clocks) when booted with
		 * lk2nd.pass-simplefb=xrgb8888 on the cmdline.
		 */
	};

	/*
	 * No reserved-memory framebuffer@83000000: lk2nd injects the
	 * authoritative cont-splash node for the live framebuffer
	 * (0x83200000, 468 KiB) when booted with lk2nd.pass-simplefb.
	 * The old 12 MiB splash_region from downstream overlaps it and
	 * triggers "reserved mem: OVERLAP DETECTED" at boot.
	 */

	/*
	 * TODO: real battery characterization (downstream: 100k therm,
	 * vref 1.8V, vddmax 4.36V). Values provisional until BMS logs
	 * are captured under the mainline kernel.
	 */
	bat: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4360000>;
		charge-full-design-microamp-hours = <400000>;

		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4335000 100>, <4265000 95>,
			<4207000 90>, <4152000 85>, <4101000 80>, <4051000 75>,
			<3995000 70>, <3958000 65>, <3921000 60>, <3874000 55>,
			<3838000 50>, <3815000 45>, <3797000 40>, <3783000 35>,
			<3772000 30>, <3763000 25>, <3744000 20>, <3718000 16>,
			<3692000 13>, <3689000 11>, <3688000 10>, <3687000 9>,
			<3685000 8>, <3683000 7>, <3679000 6>, <3663000 5>,
			<3620000 4>, <3555000 3>, <3461000 2>, <3312000 1>,
			<3000000 0>;
	};
};

/* FocalTech FT3267 touch: downstream irq gpio13 active, reset gpio12,
 * vdd/vcc_i2c = 8916_l6 (1.8V fixed), avdd = 8916_l17 (2.85V always-on).
 * No mainline driver yet; node is inert until the port lands.
 */
&blsp_i2c5 {
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft3267";
		reg = <0x38>;

		interrupt-parent = <&tlmm>;
		interrupts = <13 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;

		vdd-supply = <&pm8909_l6>;
		vio-supply = <&pm8909_l6>;
		avdd-supply = <&pm8909_l17>;

		touchscreen-size-x = <400>;
		touchscreen-size-y = <400>;

		pinctrl-0 = <&touchscreen_default>;
		pinctrl-names = "default";
	};
};

&blsp_uart1 {
	status = "okay";
};

&pm8909_bms {
	monitored-battery = <&bat>;
	power-supplies = <&pm8909_charger>;
	status = "okay";
};

&pm8909_charger {
	qcom,fast-charge-safe-current = <630000>;
	qcom,fast-charge-safe-voltage = <4300000>;

	monitored-battery = <&bat>;

	status = "okay";
};

&pm8909_vib {
	status = "okay";
};

&sdhc_1 {
	status = "okay";
};

/*
 * USB: peripheral-only so ci-hdrc always runs the gadget (no ID-pin
 * dependency). extcon = pm8909_charger: the pm8916 LBC driver holds the
 * usbin VBUS IRQ and exposes EXTCON_USB. Do NOT enable pm8909_usbin
 * (extcon-pm8941-misc) alongside the charger - both request the same
 * IRQ and the second prober hard-fails with -EBUSY, leaving any USB
 * node referencing it deferred forever (seen on boot #5).
 */
&usb {
	extcon = <&pm8909_charger>;
	dr_mode = "peripheral";
	status = "okay";
};

&usb_hs_phy {
	extcon = <&pm8909_charger>;
	status = "okay";
};

&wcnss {
	status = "okay";
};

&wcnss_iris {
	compatible = "qcom,wcn3620";
};

&smd_rpm_regulators {
	/*
	 * Voltage ranges from the downstream 3.18 DTB (stock-dtbs/01.dtb,
	 * rpm-regulator-ldoa*). The dtsi leaves every rpm regulator as an
	 * empty node {}: without board-level min/max the regulator core
	 * rejects every voltage change ("voltage operation not allowed"),
	 * which killed eMMC (vmmc = l8) and the USB HS phy (l7/l13) on
	 * the first mainline boots.
	 */
	s2 {
		/* unused on W1A (downstream: disabled) */
		regulator-min-microvolt = <1850000>;
		regulator-max-microvolt = <1850000>;
	};

	l1 {
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
	};

	l2 {
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	l4 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* vqmmc for eMMC (HS200 1.8V signaling) */
	l5 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* touch + wcnss iris rails: always-on downstream */
	l6 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/* USB HS phy v1p8 */
	l7 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* vmmc for eMMC (downstream: fixed 2.9V) */
	l8 {
		regulator-min-microvolt = <2900000>;
		regulator-max-microvolt = <2900000>;
	};

	l9 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/* wcnss iris vddrfa (downstream range; driver requests 2.75V) */
	l10 {
		regulator-min-microvolt = <2700000>;
		regulator-max-microvolt = <2800000>;
	};

	l11 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <2950000>;
	};

	l12 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <2950000>;
	};

	/* USB HS phy v3p3 */
	l13 {
		regulator-min-microvolt = <3075000>;
		regulator-max-microvolt = <3075000>;
	};

	l14 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};

	l15 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};

	/* wcnss iris avdd, always-on downstream */
	l17 {
		regulator-min-microvolt = <2850000>;
		regulator-max-microvolt = <2850000>;
		regulator-always-on;
	};

	l18 {
		regulator-min-microvolt = <2700000>;
		regulator-max-microvolt = <2700000>;
	};
};

&tlmm {
	touchscreen_default: touchscreen-default-state {
		reset-pins {
			pins = "gpio12";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		touchscreen-pins {
			pins = "gpio13";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};
